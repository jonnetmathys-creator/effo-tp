---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const faq = [
  { q: "Dans quels départements intervenez-vous ?", a: "Nous intervenons dans tout le Grand Ouest : Loire-Atlantique, Vendée, Morbihan, Maine-et-Loire et Ille-et-Vilaine. Pour un projet au-delà de cette zone, n'hésitez pas à nous consulter." },
  { q: "Le devis est-il gratuit ?", a: "Oui. L'étude de votre besoin et le devis sont gratuits et sans engagement. Nous nous déplaçons pour évaluer le chantier lorsque c'est nécessaire." },
  { q: "Travaillez-vous pour les particuliers et les professionnels ?", a: "Nos prestations de génie civil, fibre et GSM s'adressent aux professionnels. Pour l'installation de bornes de recharge IRVE, nous accompagnons aussi bien les particuliers que les professionnels." },
  { q: "Réalisez-vous le génie civil ET le raccordement fibre ?", a: "Oui, nous proposons des solutions clés en main : de l'étude de faisabilité au génie civil, jusqu'à la pose, la soudure et le raccordement final de la fibre." },
  { q: "Quels sont vos délais d'intervention ?", a: "Ils dépendent de la nature et de l'ampleur du chantier. Notre structure à taille humaine nous permet d'être réactifs : un planning précis vous est communiqué dès le devis." },
  { q: "Proposez-vous l'installation de bornes de recharge (IRVE) ?", a: "Oui. Nous installons des bornes de recharge pour véhicules électriques, de l'étude de votre installation jusqu'à la mise en service, pour les particuliers comme pour les professionnels." },
];
---
<Base title="Contact & demande de devis | EFFO-TP" description="Contactez EFFO-TP pour vos projets de génie civil, fibre optique, GSM ou IRVE près de Nantes. Demande de devis rapide.">
  <PageHeader
    eyebrow="Nous solliciter"
    title="Parlons de votre projet"
    subtitle="Un projet de génie civil, de déploiement fibre, de site GSM ou d'installation IRVE ? Décrivez-nous votre besoin, nous revenons vers vous rapidement."
    image="/assets/img/batiment-effo.jpg"
  />

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-14">
      <!-- Coordonnées -->
      <div>
        <h2 class="font-display font-bold text-2xl">Coordonnées</h2>
        <div class="mt-8 space-y-5">
          <a href="tel:0651397482" class="flex items-center gap-4 group">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition"><i data-lucide="phone" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Téléphone</span><span class="font-semibold text-lg">06 51 39 74 82</span></span>
          </a>
          <a href="mailto:quentin.bernard@effo-tp.com" class="flex items-center gap-4 group">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-green group-hover:bg-brand-green group-hover:text-white transition"><i data-lucide="mail" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Email</span><span class="font-semibold text-lg">quentin.bernard@effo-tp.com</span></span>
          </a>
          <div class="flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-blue"><i data-lucide="map-pin" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Adresse</span><span class="font-semibold text-lg">39 Rte du Champ Blond, 44450 Divatte-sur-Loire</span></span>
          </div>
        </div>
        <div class="mt-8 rounded-2xl overflow-hidden border border-slate-200 h-64">
          <iframe title="Carte EFFO-TP" class="w-full h-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            src="https://www.google.com/maps?q=39+Rte+du+Champ+Blond,+44450+Divatte-sur-Loire&output=embed"></iframe>
        </div>
      </div>

      <!-- Formulaire -->
      <form class="bg-paper rounded-2xl p-7 border border-slate-100" id="contactForm" novalidate>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="text-sm text-slate2" for="prenom">Prénom <span class="text-brand-blue">*</span></label><input id="prenom" name="prenom" required autocomplete="given-name" type="text" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Damien" /></div>
          <div><label class="text-sm text-slate2" for="nom">Nom <span class="text-brand-blue">*</span></label><input id="nom" name="nom" required autocomplete="family-name" type="text" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Dubois" /></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 mt-4">
          <div><label class="text-sm text-slate2" for="email">Email <span class="text-brand-blue">*</span></label><input id="email" name="email" required autocomplete="email" type="email" inputmode="email" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="damien.dubois@entreprise.fr" /></div>
          <div><label class="text-sm text-slate2" for="tel">Téléphone <span class="text-brand-blue">*</span></label><input id="tel" name="tel" required autocomplete="tel" type="tel" inputmode="tel" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="06 12 34 56 78" /></div>
        </div>
        <div class="mt-4"><label class="text-sm text-slate2" for="entreprise">Entreprise</label><input id="entreprise" name="entreprise" type="text" autocomplete="organization" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Nom de l'entreprise" /></div>
        <div class="mt-4"><label class="text-sm text-slate2" for="sujet">Votre besoin</label>
          <select id="sujet" name="sujet" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none">
            <option>Génie civil</option><option>Fibre optique</option><option>Site GSM</option><option>Borne IRVE</option><option>Autre</option>
          </select>
        </div>
        <div class="mt-4"><label class="text-sm text-slate2" for="message">Votre projet <span class="text-brand-blue">*</span></label><textarea id="message" name="message" required rows="5" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Bonjour, j'aurais voulu un devis pour…"></textarea></div>
        <label class="mt-4 flex items-start gap-3 text-[13px] text-slate2 cursor-pointer">
          <input id="rgpd" name="rgpd" required type="checkbox" class="mt-0.5 w-4 h-4 shrink-0 accent-brand-blue" />
          <span>J'accepte que mes informations soient utilisées uniquement pour répondre à ma demande. <span class="text-brand-blue">*</span> <a href="/mentions-legales" class="underline hover:text-brand-blue">En savoir plus</a></span>
        </label>
        <button type="submit" class="mt-5 w-full inline-flex items-center justify-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold px-6 py-3.5 rounded-full transition disabled:opacity-60 disabled:cursor-not-allowed">Envoyer ma demande <i data-lucide="send" class="w-4 h-4"></i></button>
        <p id="formStatus" role="status" aria-live="polite" class="mt-3 text-sm text-center"></p>
        <p class="mt-1 text-xs text-slate2 text-center">Champs marqués <span class="text-brand-blue">*</span> obligatoires. Réponse sous 24–48 h ouvrées.</p>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-paper">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center anim anim-up">
        <span class="text-brand-blue font-semibold uppercase tracking-wide text-sm">Questions fréquentes</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl mt-3">Vous vous posez ces questions ?</h2>
        <p class="mt-3 text-slate2 text-lg">Si vous ne trouvez pas votre réponse, écrivez-nous : on revient vers vous vite.</p>
      </div>
      <div class="mt-10 space-y-3">
        {faq.map((item, i) => (
          <details class="faq-item anim anim-up group bg-white rounded-xl border border-slate-100 shadow-soft overflow-hidden" data-delay={i * 60}>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 font-display font-semibold text-ink select-none">
              <span>{item.q}</span>
              <i data-lucide="chevron-down" class="faq-chevron w-5 h-5 text-brand-blue shrink-0 transition-transform duration-300"></i>
            </summary>
            <div class="px-5 pb-5 -mt-1 text-slate2 leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />

  <script is:inline>
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;
      var status = document.getElementById('formStatus');
      function setError(el, msg) {
        el.classList.add('border-red-400', 'ring-2', 'ring-red-200');
        el.setAttribute('aria-invalid', 'true');
      }
      function clearError(el) {
        el.classList.remove('border-red-400', 'ring-2', 'ring-red-200');
        el.removeAttribute('aria-invalid');
      }
      form.querySelectorAll('input,textarea,select').forEach(function (el) {
        el.addEventListener('input', function () { clearError(el); });
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var firstInvalid = null;
        form.querySelectorAll('[required]').forEach(function (el) {
          var ok = el.type === 'checkbox' ? el.checked : String(el.value).trim() !== '' && (el.type !== 'email' || /.+@.+\..+/.test(el.value));
          if (!ok) { setError(el); if (!firstInvalid) firstInvalid = el; } else { clearError(el); }
        });
        if (firstInvalid) {
          status.textContent = 'Merci de compléter les champs manquants.';
          status.className = 'mt-3 text-sm text-center text-red-600';
          firstInvalid.focus();
          return;
        }
        // Démo : à connecter à Formspree / Web3Forms (action + method POST)
        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        status.textContent = 'Envoi en cours…';
        status.className = 'mt-3 text-sm text-center text-slate2';
        setTimeout(function () {
          form.reset();
          btn.disabled = false;
          status.textContent = '✅ Merci ! Votre demande a bien été prise en compte. (Démo : à connecter à un service d’envoi pour la mise en ligne.)';
          status.className = 'mt-3 text-sm text-center text-brand-green font-semibold';
        }, 600);
      });
    })();
  </script>
</Base>
