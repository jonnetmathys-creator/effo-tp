---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const faq = [
  { q: "Dans quels départements intervenez-vous ?", a: "Notre zone habituelle couvre le Grand Ouest, de la Bretagne à la Gironde en passant par les Pays de la Loire et la Normandie. Pour un chantier d'ampleur en dehors de ce secteur, n'hésitez pas à nous consulter : nous étudions chaque demande." },
  { q: "Le devis est-il gratuit ?", a: "Oui. L'étude de votre besoin et le devis sont gratuits et sans engagement. Nous nous déplaçons pour évaluer le chantier lorsque c'est nécessaire." },
  { q: "Travaillez-vous pour les particuliers et les professionnels ?", a: "Nos prestations de génie civil s'adressent principalement aux professionnels (IRVE, RTE, SNCF, installateurs, opérateurs). Nous intervenons aussi pour les particuliers, notamment pour les adductions télécom, le terrassement et les aménagements extérieurs." },
  { q: "Réalisez-vous des projets clés en main ?", a: "Oui. De l'étude de faisabilité au génie civil, jusqu'à la remise en état des ouvrages, nous proposons des solutions complètes et prêtes à être réceptionnées." },
  { q: "Quels sont vos délais d'intervention ?", a: "Ils dépendent de la nature et de l'ampleur du chantier. Notre structure à taille humaine nous permet d'être réactifs : un planning précis vous est communiqué dès le devis." },
  { q: "Proposez-vous l'installation de bornes de recharge (IRVE) ?", a: "Oui. Nous prenons en charge les travaux de génie civil nécessaires à l'installation de bornes de recharge, et selon les projets la pose des bornes et le tirage des câbles, pour les particuliers comme pour les professionnels." },
];
---
<Base title="Contact & demande de devis | EFFO-TP" description="Contactez EFFO-TP pour vos projets de génie civil, IRVE, terrassement, viabilisation ou aménagements près de Nantes. Devis gratuit, particuliers et professionnels.">
  <PageHeader
    eyebrow="Nous solliciter"
    title="Parlons de votre projet"
    subtitle="Un projet de génie civil, d'IRVE, de terrassement, de viabilisation ou d'aménagement ? Particulier ou professionnel, décrivez-nous votre besoin, nous revenons vers vous rapidement."
    image="/assets/img/batiment-effo.jpg"
  />

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-14">
      <!-- Coordonnées -->
      <div>
        <h2 class="font-display font-bold text-2xl">Coordonnées</h2>
        <div class="mt-8 space-y-5">
          <a href="tel:0240736792" class="flex items-center gap-4 group">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition"><i data-lucide="phone" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Téléphone</span><span class="font-semibold text-lg">02 40 73 67 92</span></span>
          </a>
          <a href="mailto:contact@effo-tp.com" class="flex items-center gap-4 group">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-green group-hover:bg-brand-green group-hover:text-white transition"><i data-lucide="mail" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Email</span><span class="font-semibold text-lg">contact@effo-tp.com</span></span>
          </a>
          <div class="flex items-center gap-4">
            <span class="w-12 h-12 rounded-full bg-paper flex items-center justify-center text-brand-blue"><i data-lucide="map-pin" class="w-5 h-5"></i></span>
            <span><span class="block text-slate2 text-sm">Adresse</span><span class="font-semibold text-lg">11 Rue de l'Industrie, ZI Saint-Clément, 44450 Divatte-sur-Loire</span></span>
          </div>
        </div>
        <!-- Bloc localisation sans cookie (pas d'iframe Google Maps → conforme RGPD) -->
        <div class="mt-8 rounded-2xl border border-slate-200 bg-paper p-6">
          <div class="flex items-center gap-4">
            <span class="w-14 h-14 shrink-0 rounded-2xl bg-white shadow-soft flex items-center justify-center"><i data-lucide="map-pinned" class="w-7 h-7 text-brand-blue"></i></span>
            <div>
              <div class="font-display font-bold text-ink">EFFO-TP · Divatte-sur-Loire</div>
              <p class="text-slate2 text-sm mt-0.5">11 Rue de l'Industrie, ZI Saint-Clément, 44450 Divatte-sur-Loire</p>
            </div>
          </div>
          <div class="mt-5">
            <span class="text-xs font-semibold uppercase tracking-wide text-slate2">Itinéraire</span>
            <div class="mt-2 flex flex-wrap gap-2">
              <a href="https://maps.app.goo.gl/PNjajjcvWq3w8v4M7" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-white border border-slate-200 text-ink text-sm font-semibold px-4 py-2 rounded-full hover:border-brand-blue hover:text-brand-blue transition"><i data-lucide="map-pin" class="w-4 h-4 text-brand-blue"></i> Google Maps</a>
              <a href="https://www.waze.com/ul?q=11%20Rue%20de%20l%27Industrie%2C%20ZI%20Saint-Cl%C3%A9ment%2C%2044450%20Divatte-sur-Loire&navigate=yes" target="_blank" rel="noopener noreferrer" class="sm:hidden inline-flex items-center gap-1.5 bg-white border border-slate-200 text-ink text-sm font-semibold px-4 py-2 rounded-full hover:border-brand-blue hover:text-brand-blue transition"><i data-lucide="navigation" class="w-4 h-4 text-brand-blue"></i> Waze</a>
              <a href="https://maps.apple.com/?daddr=11%20Rue%20de%20l%27Industrie%2C%20ZI%20Saint-Cl%C3%A9ment%2C%2044450%20Divatte-sur-Loire" target="_blank" rel="noopener noreferrer" class="sm:hidden inline-flex items-center gap-1.5 bg-white border border-slate-200 text-ink text-sm font-semibold px-4 py-2 rounded-full hover:border-brand-blue hover:text-brand-blue transition"><i data-lucide="map" class="w-4 h-4 text-brand-blue"></i> Apple Plans</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulaire -->
      <form class="bg-paper rounded-2xl p-7 border border-slate-100" id="contactForm" novalidate>
        <div id="partenariatNote" style="display:none" class="mb-5 items-start gap-3 rounded-xl bg-brand-green/10 border border-brand-green/25 px-4 py-3 text-sm text-ink">
          <i data-lucide="handshake" class="w-5 h-5 text-brand-green shrink-0 mt-0.5"></i>
          <span>Vous nous écrivez au sujet d'un <strong>partenariat ou d'un sponsoring</strong>. Présentez votre projet ci-dessous, on revient vers vous rapidement.</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="text-sm text-slate2" for="prenom">Prénom <span class="text-brand-blue">*</span></label><input id="prenom" name="prenom" required autocomplete="given-name" type="text" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Damien" /></div>
          <div><label class="text-sm text-slate2" for="nom">Nom <span class="text-brand-blue">*</span></label><input id="nom" name="nom" required autocomplete="family-name" type="text" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Dubois" /></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4 mt-4">
          <div><label class="text-sm text-slate2" for="email">Email <span class="text-brand-blue">*</span></label><input id="email" name="email" required autocomplete="email" type="email" inputmode="email" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="damien.dubois@entreprise.fr" /></div>
          <div><label class="text-sm text-slate2" for="tel">Téléphone <span class="text-brand-blue">*</span></label><input id="tel" name="tel" required autocomplete="tel" type="tel" inputmode="tel" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="06 12 34 56 78" /></div>
        </div>
        <div class="mt-4">
          <span class="text-sm text-slate2">Vous êtes</span>
          <div class="mt-1.5 grid grid-cols-2 gap-3">
            <label class="profil-opt relative flex items-center justify-center gap-2 bg-white border border-slate-200 rounded-lg px-4 py-3 cursor-pointer font-medium text-ink has-[:checked]:border-brand-blue has-[:checked]:bg-brand-blue/5 has-[:checked]:text-brand-blue transition">
              <input type="radio" name="profil" value="Professionnel" class="sr-only" checked />
              <i data-lucide="briefcase" class="w-4 h-4"></i> Professionnel
            </label>
            <label class="profil-opt relative flex items-center justify-center gap-2 bg-white border border-slate-200 rounded-lg px-4 py-3 cursor-pointer font-medium text-ink has-[:checked]:border-brand-blue has-[:checked]:bg-brand-blue/5 has-[:checked]:text-brand-blue transition">
              <input type="radio" name="profil" value="Particulier" class="sr-only" />
              <i data-lucide="user" class="w-4 h-4"></i> Particulier
            </label>
          </div>
        </div>
        <div class="mt-4"><label class="text-sm text-slate2" for="entreprise">Entreprise <span class="text-slate2/70">(si professionnel)</span></label><input id="entreprise" name="entreprise" type="text" autocomplete="organization" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Nom de l'entreprise" /></div>
        <div class="mt-4"><label class="text-sm text-slate2" for="sujet">Votre besoin</label>
          <select id="sujet" name="sujet" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none">
            <option>Génie civil</option><option>IRVE &amp; énergies</option><option>RTE &amp; réseaux électriques</option><option>SNCF &amp; ferroviaire</option><option>Terrassement</option><option>Viabilisation</option><option>Adduction télécom</option><option>Aménagements extérieurs</option><option value="Partenariat &amp; sponsoring">Partenariat &amp; sponsoring</option><option>Autre</option>
          </select>
        </div>
        <div class="mt-4"><label class="text-sm text-slate2" for="message">Votre projet <span class="text-brand-blue">*</span></label><textarea id="message" name="message" required rows="5" class="mt-1.5 w-full bg-white border border-slate-200 rounded-lg px-4 py-3 focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/30 outline-none" placeholder="Bonjour, j'aurais voulu un devis pour…"></textarea></div>
        <label class="mt-4 flex items-start gap-3 text-[13px] text-slate2 cursor-pointer">
          <input id="rgpd" name="rgpd" required type="checkbox" class="mt-0.5 w-4 h-4 shrink-0 accent-brand-blue" />
          <span>J'accepte que mes informations soient utilisées uniquement pour répondre à ma demande. <span class="text-brand-blue">*</span> <a href="/politique-confidentialite" class="underline hover:text-brand-blue">En savoir plus</a></span>
        </label>
        <!-- Anti-spam (honeypot) : masqué aux humains, piège les bots -->
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" style="display:none !important" />
        <button type="submit" class="mt-5 w-full inline-flex items-center justify-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold px-6 py-3.5 rounded-full transition disabled:opacity-60 disabled:cursor-not-allowed">Envoyer ma demande <i data-lucide="send" class="w-4 h-4"></i></button>
        <p id="formStatus" role="status" aria-live="polite" class="mt-3 text-sm text-center"></p>
        <p class="mt-1 text-xs text-slate2 text-center">Champs marqués <span class="text-brand-blue">*</span> obligatoires. Réponse sous 24–48 h ouvrées.</p>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-paper">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center anim anim-up">
        <span class="text-brand-blue font-semibold uppercase tracking-wide text-sm">Questions fréquentes</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl mt-3">Vous vous posez ces questions ?</h2>
        <p class="mt-3 text-slate2 text-lg">Si vous ne trouvez pas votre réponse, écrivez-nous : on revient vers vous vite.</p>
      </div>
      <div class="mt-10 space-y-3">
        {faq.map((item, i) => (
          <details class="faq-item anim anim-up group bg-white rounded-xl border border-slate-100 shadow-soft overflow-hidden" data-delay={i * 60}>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 font-display font-semibold text-ink select-none">
              <span>{item.q}</span>
              <i data-lucide="chevron-down" class="faq-chevron w-5 h-5 text-brand-blue shrink-0 transition-transform duration-300"></i>
            </summary>
            <div class="px-5 pb-5 -mt-1 text-slate2 leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Toast de confirmation d'envoi -->
  <div id="formToast" role="status" aria-live="polite" class="fixed z-[90] bottom-24 lg:bottom-6 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 opacity-0 translate-y-3 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
    <div class="flex items-center gap-3 bg-ink text-white pl-4 pr-6 py-4 rounded-2xl shadow-2xl border border-white/10">
      <span class="w-9 h-9 shrink-0 rounded-full bg-brand-green/20 flex items-center justify-center"><i data-lucide="check" class="w-5 h-5 text-brand-green"></i></span>
      <div>
        <div class="font-display font-semibold text-sm leading-tight">Demande envoyée</div>
        <div class="text-white/70 text-xs mt-0.5">Nous vous répondons rapidement.</div>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })} />

  <script is:inline>
    (function () {
      // ⚠️ REMPLACER par la clé d'accès obtenue sur https://web3forms.com (gratuite).
      // La clé est PUBLIQUE : aucun risque à l'exposer ici.
      var WEB3FORMS_ACCESS_KEY = '2e7dc4de-0172-48e5-abff-b8928a3eed91';

      var form = document.getElementById('contactForm');
      if (!form) return;
      var status = document.getElementById('formStatus');

      // Canal dédié : arrivée via /contact?sujet=partenariat → pré-sélectionne le motif
      try {
        var sujetParam = (new URLSearchParams(window.location.search).get('sujet') || '').toLowerCase();
        if (sujetParam === 'partenariat') {
          var sel = form.elements['sujet'];
          if (sel) {
            for (var oi = 0; oi < sel.options.length; oi++) {
              if (/partenariat/i.test(sel.options[oi].value)) { sel.selectedIndex = oi; break; }
            }
          }
          var msgEl = form.elements['message'];
          if (msgEl) msgEl.setAttribute('placeholder', "Bonjour, nous organisons un évènement / notre club souhaiterait échanger avec EFFO-TP au sujet d'un partenariat…");
          var note = document.getElementById('partenariatNote');
          if (note) note.style.display = 'flex';
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (e) {}

      function setError(el, msg) {
        el.classList.add('border-red-400', 'ring-2', 'ring-red-200');
        el.setAttribute('aria-invalid', 'true');
      }
      function clearError(el) {
        el.classList.remove('border-red-400', 'ring-2', 'ring-red-200');
        el.removeAttribute('aria-invalid');
      }
      form.querySelectorAll('input,textarea,select').forEach(function (el) {
        el.addEventListener('input', function () { clearError(el); });
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var firstInvalid = null;
        form.querySelectorAll('[required]').forEach(function (el) {
          var ok = el.type === 'checkbox' ? el.checked : String(el.value).trim() !== '' && (el.type !== 'email' || /.+@.+\..+/.test(el.value));
          if (!ok) { setError(el); if (!firstInvalid) firstInvalid = el; } else { clearError(el); }
        });
        if (firstInvalid) {
          status.textContent = 'Merci de compléter les champs manquants.';
          status.className = 'mt-3 text-sm text-center text-red-600';
          firstInvalid.focus();
          return;
        }
        // Envoi réel via Web3Forms (le message part par e-mail au propriétaire)
        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        status.textContent = 'Envoi en cours…';
        status.className = 'mt-3 text-sm text-center text-slate2';

        var val = function (n) { var el = form.elements[n]; return el ? String(el.value).trim() : ''; };
        var profil = (form.elements['profil'] && form.elements['profil'].value) || 'Non renseigné';
        var entreprise = val('entreprise') || 'Non renseignée';

        var estPartenariat = /partenariat/i.test(val('sujet'));
        var libelle = estPartenariat ? 'demande de partenariat' : 'demande de devis';

        // Message unique, formaté proprement (e-mail clair, sans libellés parasites)
        var corps =
          'Nouvelle ' + libelle + ' via le site EFFO-TP.\n\n' +
          'Profil : ' + profil + '\n' +
          'Nom : ' + val('prenom') + ' ' + val('nom') + '\n' +
          'E-mail : ' + val('email') + '\n' +
          'Téléphone : ' + val('tel') + '\n' +
          'Entreprise : ' + entreprise + '\n' +
          'Type de besoin : ' + val('sujet') + '\n\n' +
          'Message :\n' + val('message');

        var data = new FormData();
        data.append('access_key', WEB3FORMS_ACCESS_KEY);
        data.append('subject', (estPartenariat ? 'Demande de partenariat · ' : 'Demande de devis · ') + val('prenom') + ' ' + val('nom') + ' (' + val('sujet') + ')');
        data.append('from_name', 'Site EFFO-TP');
        data.append('email', val('email'));   // met le visiteur en « répondre à »
        data.append('message', corps);
        data.append('botcheck', form.elements['botcheck'] && form.elements['botcheck'].checked ? true : '');

        fetch('https://api.web3forms.com/submit', { method: 'POST', body: data })
          .then(function (r) { return r.json(); })
          .then(function (json) {
            if (json && json.success) {
              form.reset();
              status.textContent = 'Votre demande a bien été envoyée. Nous vous répondons rapidement.';
              status.className = 'mt-3 text-sm text-center text-brand-green font-semibold';
              showToast();
            } else {
              status.textContent = 'Une erreur est survenue. Réessayez ou écrivez-nous à contact@effo-tp.com.';
              status.className = 'mt-3 text-sm text-center text-red-600';
            }
          })
          .catch(function () {
            status.textContent = 'Problème de connexion. Réessayez ou écrivez-nous à contact@effo-tp.com.';
            status.className = 'mt-3 text-sm text-center text-red-600';
          })
          .then(function () { btn.disabled = false; });
      });

      // Toast de confirmation
      var toastTimer = null;
      function showToast() {
        var t = document.getElementById('formToast');
        if (!t) return;
        t.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          t.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
        }, 5000);
      }
    })();
  </script>
</Base>
