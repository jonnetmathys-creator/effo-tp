---
import Base from '../layouts/Base.astro';
import MapZone from '../components/MapZone.astro';
import CtaBand from '../components/CtaBand.astro';

// Chantiers phares du hero. `name` s'affiche en bas à droite pendant l'affichage de la photo.
const heroPhotos = [
  { src: '/assets/hero/hero-1.webp', name: 'Station de recharge', alt: "Station de recharge pour véhicules électriques sous ombrières photovoltaïques, réalisée par EFFO-TP" },
  { src: '/assets/hero/hero-2.webp', name: 'Cheminement et regard', alt: "Cheminement réalisé par EFFO-TP avec regard technique intégré" },
  { src: '/assets/hero/hero-3.webp', name: 'Cour en enrobé', alt: "Cour en enrobé réalisée par EFFO-TP chez un particulier" },
  { src: '/assets/hero/hero-4.webp', name: 'Accès en enrobé', alt: "Accès et abords en enrobé réalisés par EFFO-TP" },
];

const materiel = [
  { name: 'Fourgons', icon: 'truck' },
  { name: 'Camions-bennes', icon: 'container' },
  { name: 'Mini-pelles', icon: 'construction' },
  { name: 'Remorques', icon: 'caravan' },
  { name: 'Camion 19 T avec grue', icon: 'truck' },
  { name: 'Chargeuse', icon: 'forklift' },
  { name: 'Matériel de compactage', icon: 'layers' },
];

// Zone d'intervention élargie, groupée par région (data-dep synchronisé avec la carte)
const zones = [
  { region: 'Bretagne', deps: ['Ille-et-Vilaine', 'Morbihan', "Côtes-d'Armor", 'Finistère'] },
  { region: 'Pays de la Loire', deps: ['Loire-Atlantique', 'Maine-et-Loire', 'Vendée', 'Mayenne', 'Sarthe'] },
  { region: 'Normandie', deps: ['Manche', 'Calvados', 'Orne'] },
  { region: 'Nouvelle-Aquitaine', deps: ['Deux-Sèvres', 'Vienne', 'Charente-Maritime', 'Charente', 'Gironde'] },
];

// Donneurs d'ordre / clients (grille statique)
// url : laisser '' si pas de site (le logo ne sera alors pas cliquable)
// file : '' tant que le logo SVG n'est pas fourni → affichage en texte
// h : hauteur du logo en px (desktop), calibrée pour une surface visuelle homogène
// (les logos larges sont moins hauts, les logos compacts ou aux traits fins plus hauts)
const clients = [
  { name: 'ENSIO', file: 'ensio', ar: '451.05 / 181.78', url: '', h: 52 },
  { name: 'SOLUTEL', file: 'solutel', ar: '537.76 / 200.309', url: '', h: 80 },
  { name: 'GREEN TEAM ÉNERGIE', file: 'green-team-energie', ar: '398.58 / 736.66', url: '', h: 108 },
  { name: 'Naovolt', file: 'naovolt', ar: '443.09 / 233.82', url: '', h: 50 },
  { name: 'CIRCET', file: 'circet', ar: '429 / 148', url: '', h: 42 },
  { name: 'Altitude Infrastructure', file: 'altitude-infrastructure', ar: '500.54 / 98.74', url: '', h: 34 },
  { name: 'IZIVIA by EDF', file: 'izivia', ar: '295.73 / 128.2', url: '', h: 54 },
];
// Partenaires / sponsoring local (carrousel défilant)
const partenaires = [
  { name: "La Nuit de l'Erdre", file: 'la-nuit-de-lerdre', ar: '241.98 / 74.15', url: 'https://www.lanuitdelerdre.fr', tag: 'Festival de musique', desc: "Partenaire d'un des grands rendez-vous musicaux du territoire." },
  { name: 'Les Corsaires', file: 'corsaires-nantes', ar: '424.43 / 354.51', url: 'https://www.corsairesdenantes.fr', tag: 'Club de hockey', desc: "Aux côtés des Corsaires de Nantes pour soutenir le sport local." },
];
---
<Base transparent={false}>
  <!-- ============ HERO (chantiers phares, fondu doux) ============ -->
  <section class="hero-shot relative isolate overflow-hidden hero-dark text-white flex items-center min-h-[600px] lg:min-h-[660px]">
    <!-- photos : traversent tout le hero et s'effacent sous le texte -->
    <div class="hero-stage absolute inset-0 z-[1]" aria-hidden="true">
      {heroPhotos.map((p, i) => (
        <img
          src={i === 0 ? p.src : undefined}
          data-src={i === 0 ? undefined : p.src}
          alt={p.alt}
          width="1600"
          height="800"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
          class:list={['hero-img', i === 0 && 'is-on']}
        />
      ))}
    </div>
    <div class="hero-veil absolute inset-0 z-[2] pointer-events-none"></div>

    <div class="relative z-[3] mx-auto max-w-7xl px-6 py-20 sm:py-24 w-full">
      <div class="max-w-xl lg:max-w-[34rem]">
        <span class="anim anim-up inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-white/80 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-5">
          <span class="w-8 h-[3px] bg-brand-green"></span> Génie civil · IRVE · Terrassement · Viabilisation · Grand Ouest
        </span>
        <h1 class="anim anim-up font-display font-extrabold tracking-tight text-balance text-[clamp(2.05rem,5.2vw,3.5rem)] leading-[1.08]" data-delay="80">
          Mettons notre expertise au service de vos <span class="fibre-text">projets</span>
        </h1>
        <p class="anim anim-up mt-6 text-lg text-white/70 leading-relaxed" data-delay="160">
          Située près de Nantes, EFFO-TP accompagne les installateurs de bornes de recharge, de trackers solaires et du photovoltaïque, les opérateurs de mobilité et les gestionnaires de réseaux dans leurs travaux de génie civil, de VRD, de terrassement et d'aménagement. Nos équipes interviennent dans tout le Grand Ouest.
        </p>
        <div class="anim anim-up mt-9 flex flex-wrap gap-4" data-delay="240">
          <a href="/genie-civil" class="glass inline-flex items-center gap-2 hover:bg-white/10 text-white font-semibold px-7 py-3.5 rounded-full transition">
            Découvrir nos activités
          </a>
          <a href="/contact" class="inline-flex items-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold px-7 py-3.5 rounded-full transition shadow-[0_0_34px_-4px_rgba(28,137,242,.65)]">
            Nous solliciter <i data-lucide="arrow-right" class="w-5 h-5"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- nom du chantier + progression -->
    <div class="hero-meta absolute right-6 sm:right-10 top-7 sm:top-8 z-[4] text-right">
      <div id="heroCaption" class="font-display font-semibold text-sm text-white">{heroPhotos[0].name}</div>
      <div class="bar mt-2 ml-auto h-[3px] w-32 sm:w-40 rounded-full bg-black/30 overflow-hidden">
        <span id="heroProgress" class="block h-full w-0 bg-gradient-to-r from-brand-blue to-brand-green"></span>
      </div>
    </div>
  </section>

  <!-- ============ PREUVES / CHIFFRES ============ -->
  <section class="bg-paper border-b border-slate-100">
    <div class="mx-auto max-w-7xl px-6">
      <dl class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-slate-100 rounded-2xl overflow-hidden -translate-y-10 shadow-card">
        <div class="anim anim-up bg-white px-6 py-8 text-center" data-delay="0">
          <dt class="font-display font-extrabold text-[clamp(2rem,4vw,2.8rem)] leading-none fibre-text"><span data-count="30">0</span> ans</dt>
          <dd class="mt-2 text-slate2 text-sm font-medium">d'expérience cumulée</dd>
        </div>
        <div class="anim anim-up bg-white px-6 py-8 text-center" data-delay="80">
          <dt class="font-display font-extrabold text-[clamp(2rem,4vw,2.8rem)] leading-none fibre-text"><span data-count="2021">0</span></dt>
          <dd class="mt-2 text-slate2 text-sm font-medium">entreprise familiale créée</dd>
        </div>
        <div class="anim anim-up bg-white px-6 py-8 text-center" data-delay="160">
          <dt class="font-display font-extrabold text-[clamp(1.5rem,3vw,2.4rem)] leading-none fibre-text">Grand Ouest</dt>
          <dd class="mt-2 text-slate2 text-sm font-medium">zone d'intervention élargie</dd>
        </div>
        <div class="anim anim-up bg-white px-6 py-8 text-center" data-delay="240">
          <dt class="font-display font-extrabold text-[clamp(2rem,4vw,2.8rem)] leading-none fibre-text"><span data-count="4">0</span></dt>
          <dd class="mt-2 text-slate2 text-sm font-medium">pôles de compétences complémentaires</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ NOS ACTIVITÉS ============ -->
  <section id="services" class="pb-24 pt-6 bg-paper">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl anim anim-up">
        <span class="text-brand-blue font-semibold uppercase tracking-wide text-sm">Notre expertise</span>
        <h2 class="font-display font-bold text-[clamp(2rem,4vw,3rem)] mt-3 leading-tight">Une entreprise de <span class="fibre-text">génie civil</span> polyvalente</h2>
        <p class="mt-4 text-slate2 text-lg">EFFO-TP prend en charge la préparation, le terrassement, les réseaux, les ouvrages de génie civil et les aménagements nécessaires à la mise à disposition des infrastructures énergétiques, télécom et de mobilité.</p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-6">
        <!-- Génie civil -->
        <a href="/genie-civil" class="anim anim-up scard group flex flex-col bg-white rounded-2xl shadow-card hover:shadow-2xl overflow-hidden border border-slate-100" data-delay="0">
          <div class="relative h-56 md:h-64 overflow-hidden">
            <img src="/assets/chantiers/1-1.webp" alt="Chantier de génie civil EFFO-TP" width="1600" height="1200" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent"></div>
            <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/95 text-ink text-xs font-bold px-3 py-1.5 rounded-full"><i data-lucide="hard-hat" class="w-3.5 h-3.5 text-brand-blue"></i> Génie civil</span>
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="font-display font-bold text-xl leading-snug">Génie civil traditionnel &amp; spécifique</h3>
            <p class="mt-3 text-slate2 leading-relaxed flex-1">Ouvrages de génie civil pour l'énergie, le télécom et la mobilité : IRVE &amp; photovoltaïque, RTE &amp; réseaux électriques, SNCF &amp; ferroviaire, travaux spécifiques.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {['IRVE & photovoltaïque', 'RTE', 'SNCF & mobilité', 'Travaux spécifiques'].map((t) => (
                <span class="text-xs font-medium bg-paper text-slate2 px-2.5 py-1 rounded-full border border-slate-100">{t}</span>
              ))}
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-brand-blue font-semibold">Découvrir <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1.5 transition"></i></span>
          </div>
        </a>

        <!-- Terrassement & aménagements -->
        <a href="/terrassement" class="anim anim-up scard group flex flex-col bg-white rounded-2xl shadow-card hover:shadow-2xl overflow-hidden border border-slate-100" data-delay="120">
          <div class="relative h-56 md:h-64 overflow-hidden">
            <img src="/assets/chantiers/1-2.webp" alt="Terrassement et aménagement extérieur EFFO-TP" width="1600" height="1200" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent"></div>
            <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/95 text-ink text-xs font-bold px-3 py-1.5 rounded-full"><i data-lucide="shovel" class="w-3.5 h-3.5 text-brand-green"></i> Terrassement &amp; aménagements</span>
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="font-display font-bold text-xl leading-snug">Terrassement &amp; aménagements extérieurs</h3>
            <p class="mt-3 text-slate2 leading-relaxed flex-1">Pour les professionnels comme pour les particuliers : terrassement, viabilisation, adduction télécom, terrasses béton, mini-piscines, terrains de pétanque et aménagements extérieurs.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {['Terrassement', 'Viabilisation', 'Terrasses béton', 'Mini-piscines', 'Pétanque'].map((t) => (
                <span class="text-xs font-medium bg-paper text-slate2 px-2.5 py-1 rounded-full border border-slate-100">{t}</span>
              ))}
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-brand-blue font-semibold">Découvrir <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1.5 transition"></i></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ REALISATIONS / MATERIEL ============ -->
  <section id="realisations" class="relative overflow-hidden py-24 bg-ink text-white">
    <div class="blob absolute -top-24 -left-24 w-[380px] h-[380px] rounded-full bg-brand-blue/10 blur-3xl pointer-events-none" data-parallax="0.06" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6">
      <div class="grid lg:grid-cols-2 gap-x-10 gap-y-4 items-end">
        <div class="anim anim-up">
          <span class="text-brand-green font-semibold uppercase tracking-wide text-sm">Réalisations &amp; matériel</span>
          <h2 class="font-display font-bold text-[clamp(2rem,4vw,3rem)] mt-3 leading-tight">Un savoir-faire éprouvé, un <span class="fibre-text">parc adapté</span> à chaque chantier</h2>
        </div>
        <p class="text-white/70 text-lg anim anim-up" data-delay="120">EFFO-TP met son expertise au service de vos projets de génie civil : ouverture de tranchées, pose de fourreaux, chambres de tirage et armoires techniques. Des réalisations solides et conformes aux exigences du secteur.</p>
      </div>

      <div class="mt-12 grid lg:grid-cols-12 gap-6 items-stretch">
        <!-- Visuel réalisation (dominant, cliquable) -->
        <a href="/realisations" class="scard group anim anim-up lg:col-span-7 relative rounded-2xl overflow-hidden min-h-[340px] md:min-h-[420px] flex" data-delay="0">
          <img src="/assets/chantiers/1-3.webp" alt="Du terrassement au raccordement final, chantier EFFO-TP" width="1200" height="1600" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-transparent"></div>
          <div class="relative mt-auto p-7 md:p-9 max-w-xl">
            <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur text-white text-xs font-bold px-3 py-1.5 rounded-full border border-white/15"><i data-lucide="hard-hat" class="w-3.5 h-3.5 text-brand-green"></i> Chantiers menés de A à Z</span>
            <h3 class="font-display font-bold text-2xl md:text-3xl mt-4 leading-tight">Du terrassement au raccordement final</h3>
            <p class="mt-2.5 text-white/70 leading-relaxed">Tranchées, fourreaux, chambres de tirage, armoires techniques : des ouvrages solides, conformes et durables.</p>
            <span class="mt-5 inline-flex items-center gap-2 text-white font-semibold">Voir nos réalisations <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1.5 transition"></i></span>
          </div>
        </a>

        <!-- Parc matériel (panneau structuré) -->
        <div class="anim anim-up lg:col-span-5 rounded-2xl border border-white/10 bg-ink-800/60 p-7 md:p-8 flex flex-col" data-delay="120">
          <div class="flex items-center gap-2.5 text-brand-green">
            <i data-lucide="wrench" class="w-5 h-5"></i>
            <span class="font-semibold uppercase tracking-wide text-sm">Nos moyens techniques</span>
          </div>
          <ul class="mt-5 flex-1">
            {materiel.map((m) => (
              <li class="flex items-center gap-3.5 py-3 border-b border-white/5 last:border-0">
                <span class="w-10 h-10 rounded-lg bg-white/[0.06] flex items-center justify-center shrink-0"><i data-lucide={m.icon} class="w-5 h-5 text-brand-blue"></i></span>
                <span class="font-medium">{m.name}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-white/55 text-[15px] leading-relaxed">Des engins entretenus et performants pour intervenir efficacement, quelle que soit la complexité du terrain.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ZONE ============ -->
  <section id="zone" class="py-24 bg-paper">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="anim anim-up">
          <span class="text-brand-blue font-semibold uppercase tracking-wide text-sm">Zone d'intervention</span>
          <h2 class="font-display font-bold text-[clamp(2rem,4vw,3rem)] mt-3 leading-tight">Présents dans tout le <span class="fibre-text">Grand Ouest</span></h2>
          <p class="mt-4 text-slate2 text-lg">Une équipe locale et réactive, au plus près de vos chantiers, de la Bretagne à la Gironde.</p>
          <ul class="mt-8 space-y-0">
            {zones.map((z) => (
              <li class="flex flex-col sm:flex-row sm:gap-4 py-3.5 border-b border-slate-200/70">
                <span class="w-full sm:w-44 shrink-0 flex items-center gap-2 font-semibold text-ink"><i data-lucide="map-pin" class="w-4 h-4 text-brand-blue"></i> {z.region}</span>
                <span class="mt-1 sm:mt-0 text-slate2 text-[15px]">
                  {z.deps.map((d, i) => (
                    <span><span data-dep={d} class="zone-dep cursor-default transition hover:text-brand-blue">{d}</span>{i < z.deps.length - 1 ? ', ' : ''}</span>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="anim anim-up" data-delay="120">
          <MapZone />
        </div>
      </div>

      <!-- Bande CTA hors secteur : pleine largeur sous la liste + la carte -->
      <div class="anim anim-up mt-10 group relative overflow-hidden rounded-2xl bg-gradient-to-br from-ink to-[#12212e] text-white p-6 sm:p-8 shadow-card ring-1 ring-white/5">
        <div class="blob absolute -top-16 -right-12 w-56 h-56 rounded-full bg-brand-blue/25 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="blob absolute -bottom-16 left-1/4 w-56 h-56 rounded-full bg-brand-green/20 blur-3xl pointer-events-none" style="animation-delay:-6s" aria-hidden="true"></div>
        <div class="relative flex flex-col sm:flex-row sm:items-center gap-5">
          <div class="flex-1">
            <div class="font-display font-bold text-xl leading-snug">Un chantier hors de cette zone ?</div>
            <p class="text-white/70 mt-1.5">Pour les projets d'ampleur, nous intervenons aussi au-delà du Grand Ouest. Parlons de votre besoin.</p>
          </div>
          <a href="/contact" class="shrink-0 inline-flex items-center justify-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold px-7 py-3.5 rounded-full transition shadow-[0_10px_28px_-8px_rgba(28,137,242,.75)]">Nous consulter <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONFIANCE + PARTENAIRES ============ -->
  <section class="py-20 md:py-24 bg-paper">
    <div class="mx-auto max-w-7xl px-6">
      <!-- Clients : logo-wall encadré -->
      <div class="text-center max-w-2xl mx-auto">
        <span class="anim anim-up text-brand-blue font-semibold uppercase tracking-wide text-sm">Références</span>
        <h2 class="anim anim-up font-display font-bold text-2xl md:text-3xl mt-3" data-delay="60">Ils nous ont fait <span class="fibre-text">confiance</span></h2>
        <p class="anim anim-up mt-4 text-slate2" data-delay="100">Nous intervenons aux côtés de donneurs d'ordre et de collectivités du Grand Ouest.</p>
      </div>
      <div class="anim anim-up mt-10 rounded-3xl border border-slate-100 shadow-soft overflow-hidden grid grid-cols-2 md:grid-cols-4 gap-px bg-slate-100" data-delay="140">
        {clients.map((c) => {
          const Tag = c.url ? 'a' : 'span';
          return (
            <div class="group bg-white flex items-center justify-center px-6 py-10 md:py-12 transition-colors duration-300 hover:bg-paper">
              {c.file ? (
                <Tag
                  class:list={["logo-mono max-w-full h-[var(--lh-sm)] md:h-[var(--lh)] grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110", c.url && "cursor-pointer"]}
                  href={c.url || undefined}
                  target={c.url ? '_blank' : undefined}
                  rel={c.url ? 'noopener noreferrer' : undefined}
                  style={`--lh:${c.h}px;--lh-sm:${Math.round(c.h * 0.8)}px;aspect-ratio:${c.ar};-webkit-mask-image:url('/assets/logos/${c.file}.svg');mask-image:url('/assets/logos/${c.file}.svg')`}
                  role="img"
                  aria-label={c.url ? `${c.name} (site externe)` : c.name}
                ></Tag>
              ) : (
                <Tag
                  class:list={["font-display font-bold text-slate2/70 text-base md:text-lg text-center leading-tight transition group-hover:text-ink", c.url && "cursor-pointer"]}
                  href={c.url || undefined}
                  target={c.url ? '_blank' : undefined}
                  rel={c.url ? 'noopener noreferrer' : undefined}
                  aria-label={c.url ? `${c.name} (site externe)` : undefined}
                >{c.name}</Tag>
              )}
            </div>
          );
        })}
        <!-- cellule finale : invite (étendue sur 2 colonnes pour combler la grille) -->
        <div class="col-span-2 md:col-span-1 bg-white flex flex-col sm:flex-row md:flex-col items-center justify-center gap-x-3 gap-y-1 text-center px-6 py-10 md:py-12">
          <span class="font-display font-bold text-ink leading-tight">Et&nbsp;vous&nbsp;?</span>
          <a href="/contact" class="inline-flex items-center gap-1 text-brand-blue font-semibold text-sm hover:gap-2 transition-all">Travaillons ensemble <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
        </div>
      </div>

      <!-- Partenaires -->
      <div class="mt-20 text-center max-w-2xl mx-auto">
        <span class="anim anim-up text-brand-green font-semibold uppercase tracking-wide text-sm">Engagement local</span>
        <h2 class="anim anim-up font-display font-bold text-2xl md:text-3xl mt-3" data-delay="60">Nos <span class="fibre-text">partenaires</span></h2>
        <p class="anim anim-up mt-4 text-slate2" data-delay="100">Fiers de soutenir le sport et les évènements de notre territoire.</p>
      </div>

      <div class="mt-12 grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {partenaires.map((p, i) => (
          <div class="scard anim anim-up group bg-white rounded-2xl border border-slate-100 shadow-card overflow-hidden flex flex-col" data-delay={i * 100}>
            <div class="h-1.5 bg-gradient-to-r from-brand-blue via-brand-cyan to-brand-green"></div>
            <div class="p-8 flex flex-col items-center text-center flex-1">
              <div class="h-16 flex items-center justify-center">
                <span
                  class="logo-mono h-11 md:h-12 grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition"
                  style={`aspect-ratio:${p.ar};-webkit-mask-image:url('/assets/logos/${p.file}.svg');mask-image:url('/assets/logos/${p.file}.svg')`}
                  role="img"
                  aria-label={p.name}
                ></span>
              </div>
              <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-green bg-brand-green/10 px-3 py-1 rounded-full">{p.tag}</span>
              <h3 class="mt-3 font-display font-bold text-lg text-ink">{p.name}</h3>
              <p class="mt-2 text-slate2 text-sm leading-relaxed">{p.desc}</p>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-brand-blue font-semibold text-sm hover:gap-2.5 transition-all">Voir le site <i data-lucide="external-link" class="w-4 h-4"></i></a>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Invite partenariat -->
      <div class="anim anim-up mt-8 max-w-3xl mx-auto relative overflow-hidden rounded-2xl bg-gradient-to-br from-ink to-[#12212e] text-white p-6 sm:p-8 shadow-card ring-1 ring-white/5" data-delay="200">
        <div class="blob absolute -top-16 -right-12 w-56 h-56 rounded-full bg-brand-green/25 blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="relative flex flex-col sm:flex-row sm:items-center gap-5">
          <div class="flex-1">
            <div class="font-display font-bold text-xl leading-snug">Envie de devenir partenaire&nbsp;?</div>
            <p class="text-white/70 mt-1.5">Évènement, club, sponsoring local : parlons de la manière dont EFFO-TP peut vous accompagner.</p>
          </div>
          <a href="/contact?sujet=partenariat" class="shrink-0 inline-flex items-center justify-center gap-2 bg-brand-green hover:bg-brand-green/90 text-white font-semibold px-7 py-3.5 rounded-full transition shadow-[0_10px_28px_-8px_rgba(48,194,147,.7)]">Parlons-en <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <CtaBand title={`Un projet de génie civil, d'<span class="fibre-text">aménagements</span> ou d'IRVE ?`} subtitle="Décrivez-nous votre besoin, nous revenons vers vous rapidement." />

  <style>
    /* Le fondu. La photo n'est jamais effacée : elle couvre tout le hero et
       c'est un voile sombre qui s'éclaircit vers la droite. Effacer la photo
       à gauche créait une frontière visible entre l'aplat uni et le grain de
       la photo, même avec un dégradé parfaitement lisse. Ici le grain est
       continu d'un bord à l'autre, il n'y a donc plus rien à couper.
       Le voile suit une courbe en S (pente nulle aux deux bouts). */
    .hero-shot{ --hero-delay:6s; }
    /* Fond opaque sous les photos : pendant un fondu, rien de ce qui se trouve
       derrière le hero (le bandeau de chiffres remonte sous lui) ne peut
       transparaître et dessiner une ligne. */
    .hero-stage{ background:#0B0F14; }
    .hero-img{
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center;
      opacity:0; transition:opacity 1.2s ease-in-out;
      /* le zoom tourne sur la photo affichée et se fige (au lieu de revenir
         brutalement à son point de départ) quand elle laisse la place */
      animation:heroZoom calc(var(--hero-delay) + 1.4s) ease-out forwards;
      animation-play-state:paused;
    }
    .hero-img.is-on{ opacity:1; animation-play-state:running; }
    @keyframes heroZoom{ from{ transform:scale(1.03) } to{ transform:scale(1.10) } }
    .hero-veil{
      background:
        linear-gradient(90deg,
          rgba(11,15,20,.950) 0%,   rgba(11,15,20,.950) 30%, rgba(11,15,20,.931) 34%,
          rgba(11,15,20,.880) 38%,  rgba(11,15,20,.802) 42%, rgba(11,15,20,.704) 46%,
          rgba(11,15,20,.593) 50%,  rgba(11,15,20,.475) 54%, rgba(11,15,20,.357) 58%,
          rgba(11,15,20,.246) 62%,  rgba(11,15,20,.148) 66%, rgba(11,15,20,.070) 70%,
          rgba(11,15,20,.019) 74%,  rgba(11,15,20,0) 78%),
        linear-gradient(0deg,
          rgba(11,15,20,.46) 0%, rgba(11,15,20,.30) 10%, rgba(11,15,20,.16) 22%,
          rgba(11,15,20,.07) 36%, rgba(11,15,20,.02) 52%, rgba(11,15,20,0) 70%);
    }
    #heroProgress{ animation:heroBar var(--hero-delay) linear infinite; }
    @keyframes heroBar{ from{ width:0 } to{ width:100% } }

    /* Sur mobile et tablette : le voile s'inverse, il s'éclaircit vers le bas */
    @media (max-width:1023px){
      .hero-veil{
        background:linear-gradient(0deg,
          rgba(11,15,20,.58) 0%,  rgba(11,15,20,.52) 8%,  rgba(11,15,20,.52) 16%,
          rgba(11,15,20,.58) 24%, rgba(11,15,20,.66) 32%, rgba(11,15,20,.74) 40%,
          rgba(11,15,20,.82) 50%, rgba(11,15,20,.87) 60%, rgba(11,15,20,.90) 70%,
          rgba(11,15,20,.93) 85%, rgba(11,15,20,.94) 100%);
      }
      .hero-shot{ min-height:560px; }
    }
    @media (prefers-reduced-motion: reduce){
      .hero-img{ transition:none; animation:none }
      #heroProgress{ animation:none; width:100% }
    }
  </style>

  <!-- Carrousel du hero : défilement automatique, barre calée sur la durée réelle,
       pause quand l'onglet passe en arrière-plan, respecte « animations réduites » -->
  <script is:inline define:vars={{ names: heroPhotos.map((p) => p.name) }}>
    (function () {
      var stage = document.querySelector('.hero-stage');
      if (!stage) return;
      var imgs = Array.prototype.slice.call(stage.querySelectorAll('.hero-img'));
      var cap = document.getElementById('heroCaption');
      var bar = document.getElementById('heroProgress');
      if (imgs.length < 2) return;

      var i = 0, timer = null;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // La durée vient de --hero-delay, lue sur la barre : une seule valeur à régler,
      // la barre et le défilement ne peuvent donc pas se désynchroniser.
      var DELAY = 5000;
      if (bar) {
        var d = window.getComputedStyle(bar).animationDuration || '';
        var ms = parseFloat(d) * (d.indexOf('ms') > -1 ? 1 : 1000);
        if (ms > 500) DELAY = ms;
      }

      // Seule la 1re photo part avec la page ; les suivantes arrivent une fois
      // la page affichée, pour ne pas alourdir le premier chargement.
      function load(el) { if (el && el.dataset.src) { el.src = el.dataset.src; delete el.dataset.src; } }
      function preload() { imgs.forEach(load); }
      if (document.readyState === 'complete') preload();
      else window.addEventListener('load', preload);

      function restart(el) {
        if (!el || reduced) return;
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.animation = '';
      }
      var zc = 1, clean = null;
      function show(n) {
        i = (n + imgs.length) % imgs.length;
        var cur = imgs[i];
        load(cur);
        cur.style.zIndex = ++zc;
        restart(cur);
        cur.classList.add('is-on');
        // L'ancienne photo reste opaque sous la nouvelle pendant tout le fondu.
        // Le hero n'est donc jamais semi-transparent : pas de fuite de ce qu'il y a
        // derrière, et pas de baisse de luminosité au milieu du fondu.
        if (clean) window.clearTimeout(clean);
        clean = window.setTimeout(function () {
          for (var k = 0; k < imgs.length; k++) if (imgs[k] !== cur) imgs[k].classList.remove('is-on');
        }, 1250);
        if (cap && names[i]) cap.textContent = names[i];
        restart(bar);
      }
      function start() { if (!reduced && !timer) timer = setInterval(function () { show(i + 1); }, DELAY); }
      function stop() {
        if (timer) { clearInterval(timer); timer = null; }
        if (bar && !reduced) bar.style.animationPlayState = 'paused';
      }

      // Onglet masqué : tout se met en pause, et tout repart ensemble au retour.
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stop(); return; }
        restart(bar);
        start();
      });
      start();
    })();
  </script>
</Base>
