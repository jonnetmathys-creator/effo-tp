---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const subnav = [
  { href: '#irve', label: 'IRVE & énergies', icon: 'zap' },
  { href: '#rte', label: 'RTE & réseaux', icon: 'plug-zap' },
  { href: '#sncf', label: 'SNCF & mobilité', icon: 'train-front' },
  { href: '#specifiques', label: 'Travaux spécifiques', icon: 'wrench' },
];

const blocks = [
  {
    id: 'irve', num: '01', icon: 'zap', cat: 'irve', photo: '/assets/chantiers/1-4.jpg',
    eyebrow: 'IRVE & infrastructures énergétiques',
    title: 'Génie civil pour bornes de recharge & énergies',
    text: "EFFO-TP prend en charge l'ensemble des travaux préparatoires et de génie civil nécessaires à l'installation de bornes de recharge : terrassement, création de tranchées, pose de fourreaux, réalisation de massifs et de chambres, réseaux, bordures, revêtements et remise en état des ouvrages. Selon les projets, nos équipes peuvent également intervenir pour la pose des bornes et le tirage des câbles, afin de proposer une réalisation complète et prête à être réceptionnée. Nous travaillons en coordination avec les installateurs et les équipes électriques afin de sécuriser les délais, la qualité d'exécution et la bonne préparation du site.",
    points: ['Terrassement, tranchées et pose de fourreaux', 'Massifs, chambres, réseaux et bordures', 'Revêtements et remise en état des ouvrages', 'Pose des bornes & tirage des câbles selon les projets'],
  },
  {
    id: 'rte', num: '02', icon: 'plug-zap', cat: 'rte', photo: '/assets/chantiers/1-5.jpg',
    eyebrow: 'RTE & réseaux électriques',
    title: 'Ouvrages de génie civil pour les réseaux électriques',
    text: "EFFO-TP intervient sur les ouvrages de génie civil associés aux infrastructures et réseaux électriques : terrassement, création de plateformes, réseaux enterrés, massifs, fourreaux, chambres, bordures, voiries et remise en état des sites.",
    points: ['Terrassement et création de plateformes', 'Réseaux enterrés, massifs et fourreaux', 'Chambres, bordures et voiries', 'Remise en état des sites'],
  },
  {
    id: 'sncf', num: '03', icon: 'train-front', cat: 'sncf', photo: '/assets/chantiers/1-6.jpg',
    eyebrow: 'SNCF & infrastructures ferroviaires',
    title: 'Travaux à proximité des infrastructures ferroviaires',
    text: "EFFO-TP réalise des travaux de génie civil et d'aménagement à proximité des infrastructures ferroviaires : terrassement, réseaux, massifs, plateformes techniques, cheminements, clôtures et remise en état des emprises.",
    points: ['Terrassement et réseaux', 'Massifs et plateformes techniques', 'Cheminements et clôtures', 'Remise en état des emprises'],
  },
  {
    id: 'specifiques', num: '04', icon: 'wrench', cat: 'genie-civil', photo: '/assets/chantiers/1-7.jpg',
    eyebrow: 'Travaux spécifiques',
    title: 'Projets particuliers & interventions en site occupé',
    text: "Grâce à ses compétences techniques et à son parc matériel, EFFO-TP intervient également sur des projets spécifiques nécessitant une organisation adaptée, des travaux en site occupé ou des ouvrages particuliers.",
    points: [],
  },
];
---
<Base title="Génie civil : IRVE, RTE, SNCF & travaux spécifiques | EFFO-TP" description="EFFO-TP réalise vos ouvrages de génie civil pour l'énergie, le télécom et la mobilité : IRVE et infrastructures énergétiques, RTE et réseaux électriques, SNCF et ferroviaire, travaux spécifiques. Près de Nantes, dans tout le Grand Ouest.">
  <PageHeader
    eyebrow="Génie civil"
    title={'Génie civil traditionnel & <span class="fibre-text">spécifique</span>'}
    subtitle="Ouvrages de génie civil au service des infrastructures énergétiques, télécom et de mobilité, dans tout le Grand Ouest."
    image="/assets/img/genie-civil.jpg"
  />

  <!-- Sous-nav d'ancrage sticky -->
  <nav data-subnav class="sticky top-[72px] z-30 bg-white/90 backdrop-blur border-b border-slate-200" aria-label="Nos domaines de génie civil">
    <div class="mx-auto max-w-7xl px-6 flex gap-2 overflow-x-auto py-3 text-sm font-medium [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {subnav.map((s) => (
        <a href={s.href} class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-paper text-ink hover:bg-brand-blue hover:text-white transition">
          <i data-lucide={s.icon} class="w-4 h-4"></i> {s.label}
        </a>
      ))}
    </div>
  </nav>

  {blocks.map((b, i) => (
    <section id={b.id} data-hl class:list={['scroll-mt-[140px] py-16 md:py-20', i % 2 === 1 && 'bg-paper']}>
      <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div class="anim anim-up order-2 lg:order-1">
          <span class="inline-flex items-center gap-3">
            <span class="w-11 h-11 rounded-xl bg-brand-blue/10 flex items-center justify-center"><i data-lucide={b.icon} class="w-5 h-5 text-brand-blue"></i></span>
            <span class="text-brand-blue font-semibold uppercase tracking-wide text-sm">{b.num} · {b.eyebrow}</span>
          </span>
          <h2 class="font-display font-bold text-2xl md:text-3xl mt-4 leading-tight">{b.title}</h2>
          <p class="mt-5 text-slate2 text-lg leading-relaxed">{b.text}</p>
          {b.points.length > 0 && (
            <ul class="mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-3">
              {b.points.map((p) => (
                <li class="flex gap-3"><i data-lucide="check-circle-2" class="w-5 h-5 text-brand-green shrink-0 mt-0.5"></i><span>{p}</span></li>
              ))}
            </ul>
          )}
          <a href={`/realisations?filter=${b.cat}`} class="mt-7 inline-flex items-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold px-6 py-3 rounded-full transition">Découvrir nos réalisations <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
        </div>
        <div class="anim anim-up order-1 lg:order-2" data-delay="120">
          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden bg-ink flex items-center justify-center shadow-card">
            {b.photo ? (
              <>
                <img src={b.photo} alt={`${b.eyebrow} · chantier EFFO-TP`} width="1600" height="1200" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition duration-700 hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent pointer-events-none"></div>
                <span class="absolute top-4 left-4 font-display font-extrabold text-white/85 text-5xl leading-none select-none drop-shadow" aria-hidden="true">{b.num}</span>
              </>
            ) : (
              <>
                <div class="blob absolute -top-16 -right-10 w-56 h-56 rounded-full bg-brand-blue/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
                <div class="blob absolute -bottom-16 -left-10 w-56 h-56 rounded-full bg-brand-green/15 blur-3xl pointer-events-none" style="animation-delay:-6s" aria-hidden="true"></div>
                <i data-lucide={b.icon} class="relative w-24 h-24 text-white/15"></i>
                <span class="absolute top-4 left-4 font-display font-extrabold text-white/10 text-6xl leading-none select-none" aria-hidden="true">{b.num}</span>
                <span class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 text-white/55 text-xs font-medium"><i data-lucide="image" class="w-3.5 h-3.5"></i> Photo de chantier à venir</span>
              </>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <CtaBand title={`Un projet de <span class="fibre-text">génie civil</span> ?`} subtitle="Décrivez-nous votre chantier, nous revenons vers vous rapidement avec une solution adaptée." eyebrow="Contact" />
</Base>
