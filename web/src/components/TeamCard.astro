---
// Carte membre d'équipe, sombre, premium. Nom + rôle en surimpression.
// Prête à recevoir une vraie photo via la prop `photo` (placeholder initiales sinon).
const { name, role, photo, delay = 0 } = Astro.props;
function initials(n) { return n.split(' ').map((p) => p[0]).join('').slice(0, 2).toUpperCase(); }
---
<article
  class="anim anim-rise group relative rounded-2xl overflow-hidden bg-ink border border-white/10 transition-[transform,box-shadow,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:border-brand-blue/40 hover:shadow-[0_24px_60px_-24px_rgba(28,137,242,.55)]"
  data-delay={delay}
>
  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-br from-ink-800 to-[#0b1015]">
    {photo
      ? <img src={photo} alt={`${name}, ${role}`} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-105" />
      : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="font-display font-extrabold text-7xl text-white/[0.06] select-none transition-transform duration-700 group-hover:scale-110" aria-hidden="true">{initials(name)}</span>
          <i data-lucide="user-round" class="absolute w-9 h-9 text-white/15"></i>
        </div>
      )}

    <!-- halo de marque au survol -->
    <div class="pointer-events-none absolute -bottom-12 -right-10 w-36 h-36 rounded-full bg-brand-blue/20 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>

    <!-- liseré dégradé haut -->
    <div class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-brand-blue via-brand-green to-brand-cyan opacity-70"></div>

    <!-- nom + rôle en surimpression -->
    <div class="absolute inset-x-0 bottom-0 px-4 pb-4 pt-12 bg-gradient-to-t from-ink via-ink/75 to-transparent">
      <div class="font-display font-bold text-white leading-tight">{name}</div>
      <div class="mt-1.5 inline-flex items-center gap-1.5 text-brand-green text-[13px] font-semibold uppercase tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-green shrink-0"></span>{role}
      </div>
    </div>
  </div>
</article>
