---
// Carte chantier / réalisation, cliquable (ouvre une boîte de contexte).
// Placeholder photo en attendant les vrais visuels (prop `photo`).
const { title, location = '', desc, details = '', tags = [], category, categoryLabel, icon, photo, photos = [], thumbs = [], delay = 0 } = Astro.props;
---
<button
  type="button"
  class="proj-card anim anim-up group block w-full text-left focus:outline-none"
  data-cat={category}
  data-title={title}
  data-catlabel={categoryLabel}
  data-icon={icon}
  data-location={location}
  data-desc={details || desc}
  data-tags={tags.join('|')}
  data-photos={photos.join('|')}
  data-thumbs={thumbs.join('|')}
  aria-haspopup="dialog"
  data-delay={delay}
>
  <div class="rounded-2xl overflow-hidden bg-white border border-slate-100 shadow-soft transition-[transform,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1.5 group-hover:shadow-card group-focus-visible:ring-2 group-focus-visible:ring-brand-blue/50">
    <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-paper to-slate-200/70">
      {photo
        ? <img src={photo} alt={location ? `${title}, ${location}` : title} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
        : (
          <div class="absolute inset-0 flex items-center justify-center">
            <i data-lucide={icon} class="w-16 h-16 text-brand-blue/15 transition-transform duration-700 group-hover:scale-110"></i>
          </div>
        )}
      <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 bg-white/95 text-ink text-xs font-bold px-3 py-1.5 rounded-full shadow-soft"><i data-lucide={icon} class="w-3.5 h-3.5 text-brand-blue"></i> {categoryLabel}</span>
      {photos.length > 1 && <span class="absolute bottom-3 right-3 inline-flex items-center gap-1 text-[11px] font-semibold text-white bg-ink/70 px-2.5 py-1 rounded-full"><i data-lucide="image" class="w-3 h-3"></i> {photos.length} photos</span>}
      {!photo && <span class="absolute bottom-3 right-3 inline-flex items-center gap-1 text-[11px] font-medium text-slate2 bg-white/85 px-2 py-1 rounded-full"><i data-lucide="image" class="w-3 h-3"></i> Photo à venir</span>}
      <!-- overlay au survol -->
      <div class="absolute inset-0 bg-ink/55 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 flex items-center justify-center">
        <span class="inline-flex items-center gap-2 bg-white text-ink font-semibold px-4 py-2 rounded-full text-sm translate-y-2 group-hover:translate-y-0 transition duration-300"><i data-lucide="eye" class="w-4 h-4 text-brand-blue"></i> Voir le détail</span>
      </div>
    </div>
    <div class="p-5">
      {location && <div class="flex items-center gap-1.5 text-slate2 text-sm"><i data-lucide="map-pin" class="w-4 h-4 text-brand-green shrink-0"></i> {location}</div>}
      <h3 class="font-display font-bold text-lg leading-snug">{title}</h3>
      <p class="mt-2 text-slate2 text-[15px] leading-relaxed">{desc}</p>
      <span class="mt-4 inline-flex items-center gap-1.5 text-brand-blue font-semibold text-sm">En savoir plus <i data-lucide="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"></i></span>
    </div>
  </div>
</button>
