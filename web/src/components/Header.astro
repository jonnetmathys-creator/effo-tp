---
import Logo from './Logo.astro';

const genieCivil = [
  { href: '/genie-civil#irve', label: 'IRVE & infrastructures énergétiques', icon: 'zap' },
  { href: '/genie-civil#rte', label: 'RTE & réseaux électriques', icon: 'plug-zap' },
  { href: '/genie-civil#sncf', label: 'SNCF & mobilité', icon: 'train-front' },
  { href: '/genie-civil#specifiques', label: 'Travaux spécifiques', icon: 'wrench' },
];
const terrassement = [
  { href: '/terrassement#terrassement', label: 'Terrassement & préparation', icon: 'shovel' },
  { href: '/terrassement#viabilisation', label: 'Viabilisation & réseaux', icon: 'route' },
  { href: '/terrassement#adduction', label: 'Adduction télécom & dépannage', icon: 'cable' },
  { href: '/terrassement#terrasses', label: 'Terrasses & dalles béton', icon: 'square' },
  { href: '/terrassement#piscines', label: 'Mini-piscines', icon: 'waves' },
  { href: '/terrassement#petanque', label: 'Terrains de pétanque', icon: 'circle-dot' },
  { href: '/terrassement#amenagements', label: 'Aménagements divers', icon: 'trees' },
];
const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/genie-civil', label: 'Génie civil', children: genieCivil },
  { href: '/terrassement', label: 'Terrassement & aménagements', children: terrassement },
  { href: '/realisations', label: 'Réalisations' },
  { href: '/notre-histoire', label: 'Notre entreprise' },
  { href: '/#zone', label: "Zone d'intervention" },
];
const { transparent = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  // Les ancres de l'accueil (ex : /#zone) ne doivent pas s'allumer en même temps qu'« Accueil »
  if (base === '/') return path === '/' && !href.includes('#');
  return path.startsWith(base);
};
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="mx-auto max-w-7xl px-6 h-[72px] flex items-center justify-between">
    <a href="/" class="logo-link flex items-center" aria-label="EFFO-TP accueil">
      <Logo class="h-8 text-ink header-logo" />
      <span class="logo-sheen" aria-hidden="true"></span>
    </a>
    <nav class="hidden xl:flex items-center gap-7 whitespace-nowrap text-[15px] font-medium text-ink">
      {nav.map((n) => (
        n.children ? (
          <div class="relative group">
            <a href={n.href} aria-haspopup="true" aria-current={isActive(n.href) ? 'page' : undefined} class:list={['link-underline inline-flex items-center gap-1', isActive(n.href) && 'text-brand-blue font-semibold']}>
              {n.label} <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"></i>
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 invisible opacity-0 translate-y-1 transition duration-200 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0">
              <div class="w-80 bg-white rounded-2xl shadow-card border border-slate-100 p-2">
                {n.children.map((c) => (
                  <a href={c.href} class="group/item flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-paper transition">
                    <span class="w-9 h-9 rounded-lg bg-brand-blue/10 flex items-center justify-center shrink-0"><i data-lucide={c.icon} class="w-4 h-4 text-brand-blue"></i></span>
                    <span class="font-medium text-[15px]">{c.label}</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 ml-auto text-slate2 opacity-0 -translate-x-1 group-hover/item:opacity-100 group-hover/item:translate-x-0 transition"></i>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={['link-underline', isActive(n.href) && 'text-brand-blue font-semibold']}>{n.label}</a>
        )
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="tel:0240736792" class="xl:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-paper text-brand-blue" aria-label="Appeler"><i data-lucide="phone" class="w-5 h-5"></i></a>
      <a href="/contact" class="hidden sm:inline-flex whitespace-nowrap items-center gap-2 bg-brand-blue hover:bg-brand-blue700 text-white font-semibold text-[15px] px-5 py-2.5 rounded-full transition shadow-soft">
        Demander un devis <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
      <button id="burger" class="xl:hidden inline-flex items-center justify-center w-10 h-10 rounded-full bg-ink text-white" aria-label="Menu"><i data-lucide="menu" class="w-5 h-5"></i></button>
    </div>
  </div>
  <div id="mobileMenu" class="hidden xl:hidden border-t border-slate-200 bg-white">
    <nav class="px-6 py-4 flex flex-col gap-1 text-ink font-medium">
      {nav.map((n) => (
        <Fragment>
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class:list={['py-2.5 border-b border-slate-100', isActive(n.href) && 'text-brand-blue font-semibold']}>{n.label}</a>
          {n.children && (
            <div class="pl-3 pb-2 flex flex-col border-b border-slate-100">
              {n.children.map((c) => (
                <a href={c.href} class="py-2 text-slate2 text-[15px] flex items-center gap-2.5"><i data-lucide={c.icon} class="w-4 h-4 text-brand-blue"></i>{c.label}</a>
              ))}
            </div>
          )}
        </Fragment>
      ))}
      <a href="/contact" class="mt-1 py-2.5 text-brand-blue font-semibold">Demander un devis</a>
    </nav>
  </div>
</header>
