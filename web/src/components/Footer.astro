---
import Logo from './Logo.astro';
---
<footer class="bg-black text-white/70">
  <div class="mx-auto max-w-7xl px-6 py-16 grid md:grid-cols-4 gap-10">
    <div>
      <div class="mb-4">
        <Logo class="h-8 text-white" />
      </div>
      <p class="text-sm">Génie civil, IRVE, terrassement et aménagements, dans tout le Grand Ouest.</p>
    </div>
    <div>
      <div class="text-white font-semibold mb-4">Navigation</div>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-white">Accueil</a></li>
        <li><a href="/genie-civil" class="hover:text-white">Génie civil</a></li>
        <li><a href="/terrassement" class="hover:text-white">Terrassement &amp; aménagements</a></li>
        <li><a href="/realisations" class="hover:text-white">Réalisations</a></li>
        <li><a href="/notre-histoire" class="hover:text-white">Notre entreprise</a></li>
        <li><a href="/contact" class="hover:text-white">Demande de devis</a></li>
      </ul>
    </div>
    <div>
      <div class="text-white font-semibold mb-4">Réseaux</div>
      <ul class="space-y-2 text-sm">
        <li class="flex items-center gap-2 text-white/40"><i data-lucide="facebook" class="w-4 h-4"></i> Facebook <span class="text-xs">(bientôt)</span></li>
        <li class="flex items-center gap-2 text-white/40"><i data-lucide="instagram" class="w-4 h-4"></i> Instagram <span class="text-xs">(bientôt)</span></li>
        <li class="flex items-center gap-2 text-white/40"><i data-lucide="youtube" class="w-4 h-4"></i> YouTube <span class="text-xs">(bientôt)</span></li>
      </ul>
    </div>
    <div>
      <div class="text-white font-semibold mb-4">Contact</div>
      <ul class="space-y-2 text-sm">
        <li><a href="tel:0651397482" class="hover:text-white">06 51 39 74 82</a></li>
        <li><a href="mailto:contact@effo-tp.com" class="hover:text-white">contact@effo-tp.com</a></li>
        <li>11 Rue de l'Industrie, ZI Saint-Clément,<br>44450 Divatte-sur-Loire</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
      <span>© 2026 EFFO-TP. Tous droits réservés.</span>
      <div class="flex items-center gap-5">
        <a href="/mentions-legales" class="hover:text-white">Mentions légales</a>
        <a href="/politique-confidentialite" class="hover:text-white">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>
