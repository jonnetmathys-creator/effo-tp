---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';

const {
  title = 'EFFO-TP : Génie civil, IRVE, terrassement & aménagements près de Nantes',
  description = "EFFO-TP, expert en génie civil et terrassement près de Nantes : IRVE et infrastructures énergétiques, RTE, SNCF, viabilisation, adduction télécom et aménagements extérieurs. Particuliers et professionnels, dans tout le Grand Ouest.",
  image = '/assets/img/batiment-effo.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    document.documentElement.classList.add('js');
    // Splash de marque : une seule fois par session, jamais si "animations réduites"
    try {
      var _r = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (_r || sessionStorage.getItem('effo_splash')) document.documentElement.classList.add('splash-done');
      else sessionStorage.setItem('effo_splash', '1');
    } catch (e) {}
  </script>
  <style is:global>
    /* Splash de chargement (premier affichage de la session) */
    #page-splash { display: none; }
    html.js:not(.splash-done) #page-splash {
      display: flex; position: fixed; inset: 0; z-index: 200;
      align-items: center; justify-content: center;
      background: radial-gradient(120% 120% at 50% 40%, #12212e 0%, #0B0F14 70%);
      transition: opacity .5s ease, visibility .5s;
      animation: psSafety 0s linear 8s forwards; /* filet de sécurité ultime si le JS échoue */
    }
    #page-splash.splash-hide { opacity: 0; visibility: hidden; pointer-events: none; }
    .ps-inner { display: flex; flex-direction: column; align-items: center; gap: 22px; }
    .ps-inner > * { opacity: 0; animation: psFade .55s ease forwards; }
    .ps-bar { position: relative; width: 168px; height: 3px; border-radius: 3px; background: rgba(255,255,255,.12); overflow: hidden; }
    .ps-bar span { position: absolute; top: 0; bottom: 0; left: -45%; width: 45%; border-radius: 3px; background: linear-gradient(90deg,#39C7FD,#1C89F2 50%,#30C293); animation: psSweep 1.05s cubic-bezier(.4,0,.2,1) infinite; }
    /* Fin de chargement : la barre se remplit à 100% avant de disparaître */
    .ps-bar.ps-complete span { animation: none; left: 0; width: 100%; transition: width .25s ease; }
    @keyframes psSweep { to { left: 100%; } }
    @keyframes psFade { to { opacity: 1; } }
    @keyframes psSafety { to { opacity: 0; visibility: hidden; pointer-events: none; } }
    /* Barre de progression de navigation (changement de page) */
    #nav-progress {
      position: fixed; top: 0; left: 0; height: 3px; width: 0; z-index: 70;
      background: linear-gradient(90deg,#39C7FD,#1C89F2 50%,#30C293);
      box-shadow: 0 0 10px rgba(28,137,242,.55);
      opacity: 0; pointer-events: none;
      transition: width .35s ease, opacity .3s ease;
    }
    #nav-progress.np-active { opacity: 1; }
    /* Mise en évidence de la sous-section ciblée depuis le menu (~2,6s, légère) */
    @keyframes hlBand { 0%, 100% { box-shadow: inset 0 0 0 9999px rgba(28,137,242,0); } 14% { box-shadow: inset 0 0 0 9999px rgba(28,137,242,.07); } 55% { box-shadow: inset 0 0 0 9999px rgba(48,194,147,.05); } }
    @keyframes hlCard { 0%, 100% { box-shadow: 0 0 0 0 rgba(28,137,242,0); } 14% { box-shadow: 0 0 0 4px rgba(28,137,242,.35), 0 18px 44px -12px rgba(28,137,242,.4); } 60% { box-shadow: 0 0 0 3px rgba(48,194,147,.3), 0 18px 44px -14px rgba(28,137,242,.22); } }
    section[data-hl].hl-on { animation: hlBand 2.6s ease-out both; }
    article[data-hl].hl-on { animation: hlCard 2.6s ease-out both; position: relative; z-index: 1; }
    /* Logo du header : dégradé de marque qui suit le curseur (effet projecteur) */
    .logo-link { position: relative; }
    .logo-sheen {
      position: absolute; inset: 0; pointer-events: none;
      -webkit-mask: url(/assets/logo-effo.svg) center / contain no-repeat;
      mask: url(/assets/logo-effo.svg) center / contain no-repeat;
      background: radial-gradient(circle 60px at var(--mx, 50%) var(--my, 50%), #39C7FD 0%, #1C89F2 26%, #30C293 50%, transparent 88%);
      filter: blur(3px);
      opacity: 0; transition: opacity .4s ease;
    }
    .logo-link:hover .logo-sheen,
    .logo-link:focus-visible .logo-sheen { opacity: 1; }
    @media (prefers-reduced-motion: reduce) {
      #page-splash { display: none !important; }
      section[data-hl].hl-on, article[data-hl].hl-on { animation: none; }
      .logo-sheen { transition: none; }
    }
  </style>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600&display=swap" /></noscript>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'GeneralContractor',
    name: 'EFFO-TP',
    description: 'Génie civil et terrassement : IRVE, RTE, SNCF, viabilisation, adduction télécom et aménagements extérieurs.',
    telephone: '+33651397482',
    email: 'contact@effo-tp.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: "11 Rue de l'Industrie, ZI Saint-Clément",
      postalCode: '44450',
      addressLocality: 'Divatte-sur-Loire',
      addressCountry: 'FR',
    },
    areaServed: ['Loire-Atlantique', 'Maine-et-Loire', 'Vendée', 'Mayenne', 'Sarthe', 'Ille-et-Vilaine', 'Morbihan', "Côtes-d'Armor", 'Finistère', 'Manche', 'Calvados', 'Orne', 'Deux-Sèvres', 'Vienne', 'Charente-Maritime', 'Charente', 'Gironde'],
    foundingDate: '2021-03',
  })} />
</head>
<body class="bg-white antialiased pb-[76px] lg:pb-0">
  <!-- Splash de marque (1re visite de la session) -->
  <div id="page-splash" aria-hidden="true">
    <div class="ps-inner">
      <Logo class="h-9 text-white" />
      <div class="ps-bar"><span></span></div>
    </div>
  </div>
  <!-- Barre de progression au changement de page -->
  <div id="nav-progress" aria-hidden="true"></div>
  <script is:inline>
    (function () {
      // 1) Splash : reste tant que la page n'est pas prête (patiente si le chargement traîne)
      var splash = document.getElementById('page-splash');
      if (splash && !document.documentElement.classList.contains('splash-done')) {
        var start = performance.now(), hidden = false;
        var hide = function () {
          if (hidden) return; hidden = true;
          var bar = splash.querySelector('.ps-bar');
          if (bar) bar.classList.add('ps-complete');      // remplit la barre à 100%
          setTimeout(function () {
            splash.classList.add('splash-hide');
            setTimeout(function () { splash.style.display = 'none'; }, 550);
          }, 240);
        };
        // On attend le vrai chargement (window.load), avec un minimum de 550ms pour voir l'animation
        var done = function () { setTimeout(hide, Math.max(0, 550 - (performance.now() - start))); };
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        setTimeout(hide, 8000); // filet de sécurité : ne jamais bloquer au-delà de 8s
      }

      // 2) Barre de navigation : démarre quand on quitte la page vers une autre
      var np = document.getElementById('nav-progress');

      // 2b) Indicateur de chargement sur la page courante si des éléments tardent (> 500ms)
      if (np && document.readyState !== 'complete') {
        var slowTimer = setTimeout(function () {
          np.classList.add('np-active');
          np.style.width = '70%';
        }, 500);
        window.addEventListener('load', function () {
          clearTimeout(slowTimer);
          if (np.classList.contains('np-active')) {
            np.style.width = '100%';
            setTimeout(function () { np.classList.remove('np-active'); np.style.width = '0%'; }, 350);
          }
        });
      }
      function startNav() {
        if (!np) return;
        np.classList.add('np-active');
        np.style.width = '0%';
        void np.offsetWidth;
        np.style.width = '82%';
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var href = a.getAttribute('href');
        if (!href || a.target === '_blank' || a.hasAttribute('download')) return;
        if (href.charAt(0) === '#' || href.indexOf('/#') === 0) return;
        if (/^(mailto:|tel:|javascript:)/i.test(href)) return;
        var url; try { url = new URL(a.href, location.href); } catch (_) { return; }
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname) return; // ancre / même page
        startNav();
      }, true);
      window.addEventListener('beforeunload', startNav);
      window.addEventListener('pageshow', function () { if (np) { np.classList.remove('np-active'); np.style.width = '0%'; } });

      // 3) Mise en évidence de la sous-section ciblée par l'ancre (#irve, #viabilisation…)
      function flashHash() {
        var id = location.hash ? location.hash.slice(1) : '';
        if (!id) return;
        var el = document.getElementById(id);
        if (!el || !el.hasAttribute('data-hl')) return;
        el.classList.remove('hl-on'); void el.offsetWidth; el.classList.add('hl-on');
        clearTimeout(el._hlT);
        el._hlT = setTimeout(function () { el.classList.remove('hl-on'); }, 2800);
      }
      function flashEl(el) {
        if (!el || !el.hasAttribute('data-hl')) return;
        el.classList.remove('hl-on'); void el.offsetWidth; el.classList.add('hl-on');
        clearTimeout(el._hlT);
        el._hlT = setTimeout(function () { el.classList.remove('hl-on'); }, 2800);
      }
      if (location.hash) {
        if (document.readyState === 'complete') setTimeout(flashHash, 450);
        else window.addEventListener('load', function () { setTimeout(flashHash, 450); });
      }
      window.addEventListener('hashchange', flashHash);
      // Déjà sur la page : clic sur une ancre interne (sous-nav) => on met aussi la cible en évidence
      document.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a[href^="#"]') : null;
        if (!a) return;
        var id = a.getAttribute('href').slice(1);
        if (!id) return;
        var el = document.getElementById(id);
        if (!el || !el.hasAttribute('data-hl')) return;
        setTimeout(function () { flashEl(el); }, 500); // après le défilement vers la cible
      }, false);
    })();
  </script>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-3 focus:left-3 focus:bg-brand-blue focus:text-white focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold">Aller au contenu</a>
  <div id="scrollProgress" class="fixed top-0 left-0 z-[60] h-[3px] w-0 origin-left" style="background:linear-gradient(90deg,#39C7FD,#1C89F2 50%,#30C293);" aria-hidden="true"></div>
  <Header transparent={Astro.props.transparent} />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <!-- Bouton retour en haut -->
  <button id="backToTop" aria-label="Revenir en haut de la page" class="fixed bottom-24 right-5 lg:bottom-6 lg:right-6 z-40 w-11 h-11 rounded-full bg-ink text-white shadow-card flex items-center justify-center opacity-0 translate-y-3 pointer-events-none transition-all duration-300 hover:bg-brand-blue">
    <i data-lucide="arrow-up" class="w-5 h-5"></i>
  </button>

  <!-- Barre CTA collante mobile -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-slate-200 px-4 py-3 flex gap-3" style="padding-bottom:calc(0.75rem + env(safe-area-inset-bottom));">
    <a href="tel:0651397482" class="flex-1 inline-flex items-center justify-center gap-2 border border-slate-300 text-ink font-semibold py-3 rounded-full"><i data-lucide="phone" class="w-4 h-4 text-brand-blue"></i> Appeler</a>
    <a href="/contact" class="flex-1 inline-flex items-center justify-center gap-2 bg-brand-blue text-white font-semibold py-3 rounded-full">Devis <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
  </div>
  <script src="https://unpkg.com/lucide@0.544.0"></script>
  <script is:inline src="https://unpkg.com/lenis@1.1.14/dist/lenis.min.js"></script>
  <script is:inline>
    // Smooth scroll (Lenis) + parallax, désactivés si reduced-motion.
    // Gère le bfcache : Lenis est détruit à la sortie de page et relancé au retour,
    // sinon le scroll reste figé après un retour/avance navigateur (fix « marche après refresh »).
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function startLenis() {
        if (reduce || window.__lenis) return;
        if (!window.Lenis) { setTimeout(startLenis, 50); return; }
        var lenis = new window.Lenis({ lerp: 0.12, wheelMultiplier: 1, smoothWheel: true });
        window.__lenis = lenis;
        (function raf(t) {
          if (window.__lenis !== lenis) return; // instance remplacée/détruite → on stoppe la boucle
          lenis.raf(t);
          requestAnimationFrame(raf);
        })();
      }
      function stopLenis() {
        if (window.__lenis) { try { window.__lenis.destroy(); } catch (e) {} window.__lenis = null; }
      }

      // Ancres internes pilotées par Lenis (référence window.__lenis → robuste après re-init)
      function bindAnchors() {
        document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach(function (a) {
          var id = a.getAttribute('href').replace('/', '');
          if (id.length <= 1) return;
          a.addEventListener('click', function (e) {
            var target = document.querySelector(id);
            if (!target || !window.__lenis) return;
            e.preventDefault();
            var header = document.querySelector('header');
            var h = header ? header.offsetHeight : 72;
            var subEl = document.querySelector('[data-subnav]');
            var sub = subEl ? subEl.offsetHeight : 0;
            window.__lenis.scrollTo(target, { offset: -(h + sub + 12) });
          });
        });
      }

      // Parallax : mesure « au repos » une seule fois (et au resize) pour éviter le layout thrashing
      function setupParallax() {
        var items = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]'));
        if (!items.length) return;
        var metrics = [];
        function measure() {
          items.forEach(function (el) { el.style.translate = ''; });
          var sy = window.scrollY || 0;
          metrics = items.map(function (el) {
            var r = el.getBoundingClientRect();
            el.style.willChange = 'translate';
            return { el: el, mid: r.top + sy + r.height / 2, speed: parseFloat(el.getAttribute('data-parallax')) || 0.1 };
          });
        }
        var ticking = false;
        function update() {
          var sy = window.scrollY || 0;
          var vhMid = window.innerHeight / 2;
          for (var i = 0; i < metrics.length; i++) {
            var m = metrics[i];
            m.el.style.translate = '0px ' + (-(m.mid - sy - vhMid) * m.speed).toFixed(1) + 'px';
          }
          ticking = false;
        }
        window.addEventListener('scroll', function () { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
        var rT;
        window.addEventListener('resize', function () { clearTimeout(rT); rT = setTimeout(function () { measure(); update(); }, 150); }, { passive: true });
        measure();
        update();
      }

      window.addEventListener('load', function () {
        if (reduce) return;
        startLenis();
        bindAnchors();
        setupParallax();
      });
      // Sortie de page → on détruit Lenis pour que le bfcache stocke une page « propre »
      window.addEventListener('pagehide', stopLenis);
      // Retour/avance navigateur (page restaurée du cache) → on déverrouille et on relance le scroll
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        document.body.style.overflow = '';
        document.documentElement.classList.remove('lenis-stopped');
        startLenis();
      });
    })();
  </script>
  <script is:inline>
    window.addEventListener('load', () => {
      if (window.lucide) window.lucide.createIcons();
      const burger = document.getElementById('burger');
      const menu = document.getElementById('mobileMenu');
      if (burger && menu) {
        burger.addEventListener('click', () => menu.classList.toggle('hidden'));
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const d = e.target.getAttribute('data-delay');
            if (d) e.target.style.transitionDelay = d + 'ms';
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal, .anim').forEach((el) => io.observe(el));

      // Cursor spotlight on premium cards
      document.querySelectorAll('.scard').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
          card.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
        });
      });

      // Logo header : le dégradé « projecteur » suit le curseur avec un léger lissage
      const reduceLogo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('.logo-link').forEach((link) => {
        let tx = 0, ty = 0, cx = 0, cy = 0, raf = null, over = false;
        const setVars = (x, y) => { link.style.setProperty('--mx', x + 'px'); link.style.setProperty('--my', y + 'px'); };
        const loop = () => {
          cx += (tx - cx) * 0.16;
          cy += (ty - cy) * 0.16;
          setVars(cx, cy);
          if (over || Math.abs(tx - cx) > 0.4 || Math.abs(ty - cy) > 0.4) raf = requestAnimationFrame(loop);
          else raf = null;
        };
        link.addEventListener('pointerenter', (e) => {
          const r = link.getBoundingClientRect();
          tx = cx = e.clientX - r.left; ty = cy = e.clientY - r.top; // démarre sous le curseur (pas de saut)
          over = true;
          if (reduceLogo) { setVars(cx, cy); return; }
          if (!raf) loop();
        });
        link.addEventListener('pointermove', (e) => {
          const r = link.getBoundingClientRect();
          tx = e.clientX - r.left; ty = e.clientY - r.top;
          if (reduceLogo) { setVars(tx, ty); return; }
          if (!raf) loop();
        });
        link.addEventListener('pointerleave', () => { over = false; });
      });

      // Barre de progression scroll + élévation header + bouton retour en haut
      const progress = document.getElementById('scrollProgress');
      const header = document.querySelector('header');
      const toTop = document.getElementById('backToTop');
      let stick = false;
      function onScroll() {
        const st = window.scrollY || document.documentElement.scrollTop;
        const h = document.documentElement.scrollHeight - window.innerHeight;
        if (progress) progress.style.width = (h > 0 ? (st / h) * 100 : 0) + '%';
        if (header) header.classList.toggle('shadow-card', st > 8);
        if (toTop) {
          const show = st > 600;
          toTop.classList.toggle('opacity-0', !show);
          toTop.classList.toggle('translate-y-3', !show);
          toTop.classList.toggle('pointer-events-none', !show);
        }
        stick = false;
      }
      window.addEventListener('scroll', () => { if (!stick) { requestAnimationFrame(onScroll); stick = true; } }, { passive: true });
      onScroll();
      if (toTop) toTop.addEventListener('click', () => {
        if (window.__lenis) window.__lenis.scrollTo(0); else window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Compteurs animés (respecte prefers-reduced-motion)
      const reduceMo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll('[data-count]');
      if (counters.length) {
        const cio = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            const el = en.target;
            const target = parseInt(el.getAttribute('data-count'), 10) || 0;
            cio.unobserve(el);
            if (reduceMo) { el.textContent = String(target); return; }
            const dur = 1400, start = performance.now();
            let last = null;
            (function tick(now) {
              const p = Math.min((now - start) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              const val = Math.round(target * eased);
              if (val !== last) { el.textContent = String(val); last = val; }
              if (p < 1) requestAnimationFrame(tick);
            })(start);
          });
        }, { threshold: 0.4 });
        counters.forEach((c) => cio.observe(c));
      }

      // Marquee piloté en JS : ralentissement fluide au survol (pas de saut)
      const reduceMarquee = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-marquee]').forEach((track) => {
        if (reduceMarquee) return; // laissé statique
        const wrap = track.closest('.marquee') || track.parentElement;
        const base = 70; // vitesse px/s
        let target = base, cur = base, offset = 0, last = null, loopW = 0, rt;
        function measure() {
          const n = track.children.length;
          const half = Math.floor(n / 2) || 1;
          loopW = track.children[half].offsetLeft - track.children[0].offsetLeft;
        }
        measure();
        window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(measure, 150); }, { passive: true });
        wrap.addEventListener('pointerenter', () => { target = base * 0.15; });
        wrap.addEventListener('pointerleave', () => { target = base; });
        function frame(t) {
          if (last === null) last = t;
          let dt = (t - last) / 1000; last = t;
          if (dt > 0.1) dt = 0.1; // anti-saut si l'onglet revient au premier plan
          cur += (target - cur) * Math.min(1, dt * 3); // glisse vers la vitesse cible
          offset += cur * dt;
          if (loopW > 0) { while (offset >= loopW) offset -= loopW; }
          track.style.transform = 'translate3d(' + (-offset).toFixed(2) + 'px,0,0)';
          requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      });
    });
  </script>
</body>
</html>
